<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/4.0.6">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <ProductVersion>2.0.0</ProductVersion>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputPath>bin\$(Configuration)\$(Platform)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(Platform)\</IntermediateOutputPath>
    <DefineConstants>ProductVersion=$(ProductVersion);Platform=$(Platform)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

  <!-- Reference to the MSI project -->
  <ItemGroup>
    <ProjectReference Include="..\PrimoraInstaller\PrimoraInstaller.wixproj">
      <OutputItemType>PackageGroupRef</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
