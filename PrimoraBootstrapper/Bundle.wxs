<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle
    Name="Primora"
    Manufacturer="Primers Corporation"
    Version="$(ProductVersion)"
    UpgradeCode="3A5C7E9B-1D3F-5B7D-9E1C-3F5B7D9E1C3F"
    AboutUrl="https://primora-website.vercel.app"
    IconSourceFile="PrimoraInstaller\Assets\primora.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl="https://www.gnu.org/licenses/gpl-3.0.txt"
        LogoFile="PrimoraInstaller\Assets\Logo.png"
        Theme="hyperlinkLicense"
        SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain ParallelCache="yes">

      <ExePackage
        Id="vcredist_x64"
        Name="vc_redist.x64.exe"
        Compressed="no"
        DownloadUrl="https://aka.ms/vs/17/release/vc_redist.x64.exe"
        InstallArguments="/install /quiet /norestart"
        RepairArguments="/repair /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        DetectCondition="HKLM://SOFTWARE/Microsoft/VisualStudio/14.0/VC/Runtimes/X64[@Installed=1]"
        PerMachine="yes"
        Vital="no" />

      <ExePackage
        Id="dotnet8_desktop_runtime"
        Name="windowsdesktop-runtime-8.0-win-x64.exe"
        Compressed="no"
        DownloadUrl="https://aka.ms/dotnet/8.0/windowsdesktop-runtime-win-x64.exe"
        InstallArguments="/install /quiet /norestart"
        RepairArguments="/repair /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        DetectCondition="HKLM://SOFTWARE/dotnet/Setup/InstalledVersions/x64/sharedfx/Microsoft.WindowsDesktop.App/[@8.*]"
        PerMachine="yes"
        Vital="yes" />

      <ExePackage
        Id="vigembus"
        Name="ViGEmBus_Setup_x64.exe"
        Compressed="no"
        DownloadUrl="https://github.com/nefarius/ViGEmBus/releases/latest/download/ViGEmBus_Setup_x64.exe"
        InstallArguments="/install /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        DetectCondition="HKLM://SYSTEM/CurrentControlSet/Services/ViGEmBus[@Start]"
        PerMachine="yes"
        Vital="yes" />

      <MsiPackage
        Id="PrimoraMsi"
        SourceFile="$(MsiPath)"
        Vital="yes"
        ForcePerMachine="yes" />

    </Chain>

  </Bundle>
</Wix>
