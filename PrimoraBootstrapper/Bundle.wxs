<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle
    Name="Primora"
    Manufacturer="Primers Corporation"
    Version="$(ProductVersion)"
    UpgradeCode="3A5C7E9B-1D3F-5B7D-9E1C-3F5B7D9E1C3F"
    AboutUrl="https://primora-website.vercel.app"
    IconSourceFile="PrimoraInstaller\Assets\primora.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl="https://www.gnu.org/licenses/gpl-3.0.txt"
        LogoFile="PrimoraInstaller\Assets\Logo.png"
        Theme="hyperlinkLicense"
        SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <util:RegistrySearch
      Id="SearchVCRedist"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64"
      Value="Installed"
      Variable="VCRedistInstalled"
      Result="value"
      Bitness="always64" />

    <util:RegistrySearch
      Id="SearchDotNet8"
      Root="HKLM"
      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
      Variable="DotNet8KeyExists"
      Result="exists"
      Bitness="always64" />

    <util:RegistrySearch
      Id="SearchViGEmBus"
      Root="HKLM"
      Key="SYSTEM\CurrentControlSet\Services\ViGEmBus"
      Variable="ViGEmBusInstalled"
      Result="exists"
      Bitness="always64" />

    <Chain ParallelCache="yes">

      <ExePackage
        Id="vcredist_x64"
        Name="vc_redist.x64.exe"
        Compressed="no"
        DownloadUrl="https://aka.ms/vs/17/release/vc_redist.x64.exe"
        InstallArguments="/install /quiet /norestart"
        RepairArguments="/repair /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        DetectCondition="VCRedistInstalled = 1"
        PerMachine="yes"
        Vital="no" />

      <ExePackage
        Id="dotnet8_desktop_runtime"
        Name="windowsdesktop-runtime-8.0-win-x64.exe"
        Compressed="no"
        DownloadUrl="https://aka.ms/dotnet/8.0/windowsdesktop-runtime-win-x64.exe"
        InstallArguments="/install /quiet /norestart"
        RepairArguments="/repair /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        DetectCondition="DotNet8KeyExists"
        PerMachine="yes"
        Vital="yes" />

      <ExePackage
        Id="vigembus"
        Name="ViGEmBus_1.22.0_x64_x86_arm64.exe"
        Compressed="no"
        DownloadUrl="https://github.com/nefarius/ViGEmBus/releases/download/v1.22.0/ViGEmBus_1.22.0_x64_x86_arm64.exe"
        InstallArguments="/install /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        DetectCondition="ViGEmBusInstalled"
        PerMachine="yes"
        Vital="yes" />

      <MsiPackage
        Id="PrimoraMsi"
        SourceFile="$(MsiPath)"
        Vital="yes"
        ForcePerMachine="yes" />

    </Chain>

  </Bundle>
</Wix>
