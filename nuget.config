<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration for Primora solution.
  Ensures the WiX Toolset SDK (WixToolset.Sdk) is resolved from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
