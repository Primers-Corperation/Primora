<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    The application payload is harvested from the `dotnet publish` output rather than
    listed by hand. The previous hand-written list named seven files and was wrong in
    both directions: it omitted all 38 dependency assemblies and the localized satellite
    folders, and it referenced Actions.xml, Auto Profiles.xml, ControllerConfigs.xml,
    LinkedProfiles.xml and Profiles.xml, which publish never produces — Primora writes
    those into %AppData% at runtime.

    PublishDir is supplied by the build: -d PublishDir=<path to publish output>.
  -->
  <Fragment>
    <ComponentGroup Id="AppCoreComponents" Directory="INSTALLFOLDER">

      <!-- Primora.exe, its dependencies, the satellite culture folders and
           the BezierCurveEditor subfolder. -->
      <Files Include="$(PublishDir)\**" />

    </ComponentGroup>
  </Fragment>

</Wix>
